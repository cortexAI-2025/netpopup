rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    // Ensure the caller is signed in (even anonymously)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ensure the caller's UID matches the document's userId field
    function isOwner(resource) {
      return request.auth.uid == resource.data.userId;
    }

    // Validate an incoming message write
    //  - the room must exist
    //  - timestamp within ±5 min of server time (tolerates clock skew)
    //  - expiresAt at most 1 h (+ skew margin) after timestamp — Message.TTL_MS
    function validMessage() {
      let msg = request.resource.data;
      let skewMs = 5 * 60 * 1000;
      return msg.keys().hasAll(['id','roomId','userId','username','content','timestamp','expiresAt'])
        && msg.content is string
        && msg.content.size() > 0
        && msg.content.size() <= 500
        && msg.username is string
        && msg.username.size() > 0
        && msg.username.size() <= 32
        && msg.userId == request.auth.uid
        && msg.timestamp is int
        && msg.expiresAt is int
        && msg.timestamp > request.time.toMillis() - skewMs
        && msg.timestamp < request.time.toMillis() + skewMs
        && msg.expiresAt > msg.timestamp
        && msg.expiresAt <= msg.timestamp + 60 * 60 * 1000 + skewMs
        && msg.get('reported', false) == false
        && exists(/databases/$(database)/documents/rooms/$(msg.roomId));
    }

    // Validate an incoming room creation
    function validRoom(roomId) {
      let room = request.resource.data;
      return room.keys().hasAll(['id','type','zoneId','code','createdAt'])
        && room.id == roomId
        && room.type in ['LOCAL', 'PRIVATE']
        && (room.type != 'LOCAL'   || room.zoneId == roomId)
        && (room.type != 'PRIVATE' || room.code == roomId);
    }

    // ── Rooms ─────────────────────────────────────────────────────────────────
    match /rooms/{roomId} {
      // Anyone signed in can read room metadata
      allow read: if isAuthenticated();

      // Rooms are created by the client but only if the document doesn't exist
      // (prevents overwriting existing rooms)
      allow create: if isAuthenticated() && validRoom(roomId);

      // No updates or deletes from the client
      allow update, delete: if false;
    }

    // ── Messages ──────────────────────────────────────────────────────────────
    match /messages/{messageId} {
      // Any signed-in user can read messages (client filters blocked users)
      allow read: if isAuthenticated();

      // Create: must be owner and pass validation
      allow create: if isAuthenticated() && validMessage();

      // Update: only allowed for reporting (setting reported=true)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reported'])
        && request.resource.data.reported == true;

      // Delete: only the message owner can delete their own message
      allow delete: if isAuthenticated() && isOwner(resource);
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthenticated();
      allow write:  if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
