# Copier ce fichier en keystore.properties et remplir les valeurs.
# NE JAMAIS committer keystore.properties (déjà dans .gitignore).
#
# Générer un keystore :
#   keytool -genkeypair -alias netpopup -keyalg RSA -keysize 2048 \
#           -validity 10000 -keystore netpopup-release.jks
#
# Le chemin storeFile est relatif à la racine du projet.

storeFile=netpopup-release.jks
storePassword=VOTRE_MOT_DE_PASSE_KEYSTORE
keyAlias=netpopup
keyPassword=VOTRE_MOT_DE_PASSE_CLE
