<?xml version="1.0" encoding="utf-8"?>
<!--
  NetPopUp — icône bulle miniature (24×24 dp).
  Utilisée dans la TopBar (logo secondaire) et les notifications.

  À cette taille les yeux sont des cercles (#0D1F0A sur fond vert).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Corps de la bulle -->
    <path
        android:fillColor="#39FF14"
        android:pathData="
        M 7.5,3 L 16.5,3
        Q 21,3 21,7.5
        L 21,15
        Q 21,19.5 16.5,19.5
        L 13,19.5 L 11.5,22.5 L 10,19.5 L 7.5,19.5
        Q 3,19.5 3,15
        L 3,7.5
        Q 3,3 7.5,3 Z" />

    <!-- Œil gauche — cercle r=1.5, centre (9.5, 11) -->
    <path
        android:fillColor="#0D1F0A"
        android:pathData="M 8,11 A 1.5,1.5 0 1 0 11,11 A 1.5,1.5 0 1 0 8,11 Z" />

    <!-- Œil droit — cercle r=1.5, centre (14.5, 11) -->
    <path
        android:fillColor="#0D1F0A"
        android:pathData="M 13,11 A 1.5,1.5 0 1 0 16,11 A 1.5,1.5 0 1 0 13,11 Z" />

</vector>
