<?xml version="1.0" encoding="utf-8"?>
<!--
  NetPopUp launcher icon — foreground layer (adaptive icon, 108×108 dp).
  Safe zone : inner 72×72 dp centered at (18,18).

  Design :
    • Chat bubble arrondie — vert néon #39FF14
    • Deux yeux en forme de pilule (capsules verticales) — vert très sombre
    • Queue en bas-gauche
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Corps de la bulle ──────────────────────────────────────────────── -->
    <path
        android:fillColor="#39FF14"
        android:pathData="
        M 36,14 L 72,14
        Q 88,14 88,30
        L 88,68
        Q 88,82 72,82
        L 50,82 L 44,96 L 36,82 L 28,82
        Q 20,82 20,68
        L 20,30
        Q 20,14 36,14 Z" />

    <!-- ── Œil gauche (capsule verticale) ────────────────────────────────── -->
    <!--  centre x=42, y=52  |  width=12  height=24  cap-radius=6  -->
    <path
        android:fillColor="#0D1F0A"
        android:pathData="
        M 36,46
        A 6,6 0 0 1 48,46
        L 48,58
        A 6,6 0 0 1 36,58
        Z" />

    <!-- ── Œil droit (capsule verticale) ─────────────────────────────────── -->
    <!--  centre x=66, y=52  |  width=12  height=24  cap-radius=6  -->
    <path
        android:fillColor="#0D1F0A"
        android:pathData="
        M 60,46
        A 6,6 0 0 1 72,46
        L 72,58
        A 6,6 0 0 1 60,58
        Z" />

</vector>
